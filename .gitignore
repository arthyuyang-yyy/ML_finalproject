__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.env
.DS_Store

# Test run artifacts
.coverage
.coverage.*
htmlcov/
.tox/

# IDE — share workspace config but ignore user/host-specific state
.idea/
.vscode/.venv-*
.vscode/launch.local.*
.vscode/tasks.local.*
.vscode/*.code-workspace
.vscode/ipynb_checkpoints/
*.swp
*.swo

# Large input data and generated artifacts
data/raw_audio/*
data/processed_audio/*
data/external/
data/manifests/*.jsonl
local_results/
models/
outputs/*

# Audio and model files
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.pt
*.bin
*.safetensors
*.pth

# Keep empty research directories visible in Git
!data/raw_audio/.gitkeep
!data/processed_audio/.gitkeep
!data/manifests/.gitkeep
!outputs/**/
!outputs/**/.gitkeep
