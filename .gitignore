__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.env
.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo

# Large input data and generated artifacts
data/raw_audio/*
data/processed_audio/*
# Evaluation corpora (AliMeeting / AISHELL-4 / AMI): audio + derived annotations
# must never be committed. Keep data/README.md and scripts under version control.
data/alimeeting/
outputs/*

# Audio and model files
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.pt
*.bin
*.safetensors
*.pth

# Keep empty research directories visible in Git
!data/raw_audio/.gitkeep
!data/processed_audio/.gitkeep
!outputs/**/
!outputs/**/.gitkeep
