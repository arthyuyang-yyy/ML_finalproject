# Editor / IDE configuration that every editor reads. VSCode, Cursor, Trae,
# PyCharm, Sublime, vim, emacs — all honour .editorconfig when the relevant
# plugin is installed (PyCharm and modern vim/emacs ship with it built in).

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.{json,yml,yaml,toml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
