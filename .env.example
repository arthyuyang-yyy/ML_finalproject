# Copy this file to `.env` on the server and edit local values.

# Store large datasets outside the repository.
MEETING_DATA_ROOT=/srv/meeting-memory/data
ALIMEETING_ROOT=/srv/meeting-memory/data/alimeeting/Eval_Ali

# Web demo binding. Use 0.0.0.0 on a cloud server, and restrict exposure with
# a firewall, security group, SSH tunnel, or reverse proxy.
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
# GRADIO_SHARE=false

# Streamlit uses CLI flags for address/port. These are documented for operators.
# STREAMLIT_SERVER_ADDRESS=0.0.0.0
# STREAMLIT_SERVER_PORT=8501

# Optional model credentials used only when their backends are enabled.
# HF_TOKEN=
# Use cached Hugging Face/pyannote models when network access is unavailable.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# Optional LLM resolver / QA backends.
# GEMMA_BACKEND=none
# GEMMA_MODEL=gemma3:4b
# GEMMA_BASE_URL=http://127.0.0.1:11434
# LLM_BACKEND=ollama
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma3:4b
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# Optional ASR defaults used by faster-whisper candidate generation.
# FASTER_WHISPER_MODEL=small
# FASTER_WHISPER_DEVICE=cpu
# FASTER_WHISPER_COMPUTE_TYPE=int8

# Proxy for sites blocked in China (huggingface.co, etc.).
# http_proxy=http://127.0.0.1:7897
# https_proxy=http://127.0.0.1:7897
# NO_PROXY=localhost,127.0.0.1,modelscope.cn,*.modelscope.cn
